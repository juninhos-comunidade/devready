# PostgreSQL usado pelo Prisma
DATABASE_URL="postgresql://usuario:senha@localhost:5432/devready"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
# Gere um valor longo e aleatório para produção. Nunca versione o segredo real.
BETTER_AUTH_SECRET="substitua-por-um-segredo-forte"

# E-mails de verificação e recuperação (Resend)
RESEND_API_KEY="re_substitua-pela-chave-do-projeto"
EMAIL_FROM="DevReady <contato@seudominio.com>"

# Demonstração do hackathon com informações 100% fictícias
NEXT_PUBLIC_DEMO_MODE="true"

# Ative somente depois que as branches de nova sessão e resultado forem integradas
NEXT_PUBLIC_TRAINING_ROUTES_ENABLED="false"
