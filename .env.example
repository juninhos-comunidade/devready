# PostgreSQL usado pelo Prisma
DATABASE_URL="postgresql://usuario:senha@localhost:5432/devready"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
# Gere um valor longo e aleatório para produção. Nunca versione o segredo real.
BETTER_AUTH_SECRET="substitua-por-um-segredo-forte"

# Groq (extração das informações de currículos em lib/extraction.ts)
GROQ_API_KEY="gsk_substitua-pela-chave-do-projeto"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# GitHub (análise de perfil em lib/github.ts)
GITHUB_TOKEN="ghp_substitua-pelo-token-do-projeto"

# Limite de sessões simultâneas no treino por vaga (entre 3 e 5)
NEXT_PUBLIC_SESSION_LIMIT="5"
